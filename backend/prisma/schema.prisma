// Lumen Document Intelligence — relational schema (PostgreSQL)
// Every extracted value, citation and questionnaire answer stays linked to
// its original document evidence (page, section, table row, sheet, cell).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // non-pooled connection for migrations (required for Neon PgBouncer)
}

// ── Enums ────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  REVIEWER
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DocumentStatus {
  STAGED
  UPLOADING
  QUEUED
  PROCESSING
  COMPLETED
  NEEDS_REVIEW
  FAILED
}

enum StructureKind {
  HEADING
  PARAGRAPH
  FOOTNOTE
  TABLE
  SHEET
}

enum ExtractionTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ResultStatus {
  VERIFIED
  NEEDS_REVIEW
  MISSING
  REJECTED
}

enum AnswerStatus {
  AI_DRAFTED
  APPROVED
  NEEDS_REVIEW
  MISSING
  REJECTED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum CitationKind {
  PAGE
  SECTION
  TABLE_ROW
  FOOTNOTE
  SHEET
  CELL
  PARAGRAPH
}

enum Derivation {
  REPORTED
  CALCULATED
  AI_INFERRED
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// ── Identity & sessions ──────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String
  lastName      String
  passwordHash  String
  emailVerifiedAt DateTime?
  lastLoginAt   DateTime?
  onboardingStep Int       @default(0) // 0 done | 1 welcome | 2 workspace | 3 industry | 4 upload
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  memberships     Membership[]
  workspacesCreated Workspace[] @relation("WorkspaceCreator")
  sessions        Session[]
  verificationCodes VerificationCode[]
  notifications   Notification[]
  auditEvents     AuditEvent[]      @relation("AuditActor")
  documents       Document[]
  observationRevisions ObservationRevision[] @relation("RevisionActor")

  @@index([email])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Six-digit email verification codes and password-reset tokens.
model VerificationCode {
  id         String    @id @default(cuid())
  userId      String
  purpose     String // EMAIL_VERIFY | PASSWORD_RESET
  codeHash    String
  expiresAt  DateTime
  consumedAt  DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// ── Workspaces & tenancy ─────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Dedicated inbound address — email attachments sent here are ingested into
  // this workspace's Unassigned inbox (with sender/subject kept on the
  // document) by the inbound-email webhook.
  inboundEmail String? @unique
  industry  String   @default("Business")
  plan      String   @default("trial") // trial ends 14 days after createdAt
  storageUsedBytes BigInt @default(0)
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  createdBy       User              @relation("WorkspaceCreator", fields: [createdById], references: [id])
  memberships     Membership[]
  invitations     Invitation[]
  settings        WorkspaceSetting[]
  collections     Collection[]
  documents       Document[]
  conversations   Conversation[]
  extractionTasks ExtractionTask[]
  questionnaires  Questionnaire[]
  entities       Entity[]
  reports         Report[]
  notifications   Notification[]
  auditEvents     AuditEvent[]
  templates       ExtractionTemplate[]
  covenantDefinitions CovenantDefinition[]
  observationRevisions ObservationRevision[]
  savedChartViews  SavedChartView[]
  intakeBatches     IntakeBatch[]

  @@index([slug])
}

model WorkspaceSetting {
  id          String @id @default(cuid())
  workspaceId String
  key         String // e.g. questionnaires.requireCitations
  value        Json
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model Membership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(EDITOR)
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id          String       @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(EDITOR)
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email, status])
}

// ── Library & documents ──────────────────────────────────────────────────

model Collection {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  parentId    String?
  // Data Room scoping: a folder can belong to one company/subsidiary (entity).
  // PERIOD folders ("Q3 2026" etc.) are always entity-scoped; CUSTOM folders
  // may be workspace-level. Deleting an entity detaches its folders (SetNull).
  entityId    String?
  kind        String    @default("CUSTOM") // PERIOD | CUSTOM
  periodKey   String?
  createdById String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents Document[]
  entity    Entity?    @relation(fields: [entityId], references: [id], onDelete: SetNull)
  parent    Collection?  @relation("CollectionFolders", fields: [parentId], references: [id], onDelete: SetNull)
  children  Collection[] @relation("CollectionFolders")

  @@unique([workspaceId, name])
  @@index([parentId])
  @@index([entityId])
}

model Document {
  id           String         @id @default(cuid())
  workspaceId  String
  collectionId String?
  // Borrower (entity) this document belongs to — drives company pages and
  // quarterly package checks. Untagged documents stay Data-Room-only.
  entityId     String?
  name         String
  fileType     String // pdf | docx | xlsx | csv | txt | doc | xls
  mimeType     String
  sizeBytes    BigInt
  pageCount    Int?
  status       DocumentStatus @default(UPLOADING)
  error        String?
  storageKey   String // object-storage key of the original file
  ownerId      String
  isDemo       Boolean        @default(false)
  tablesUnavailable Boolean   @default(false) // PDF fell back to pdf-parse (sidecar unreachable) — tables/bboxes missing, disclosed in UI
  // Provenance: UPLOAD (user upload) or EMAIL (arrived via the inbound-email
  // webhook); EMAIL rows carry the sender/subject/received time for triage.
  source       String         @default("UPLOAD") // UPLOAD | EMAIL
  emailFrom    String?
  emailSubject String?
  emailReceivedAt DateTime?
  // Data Room triage: emailed documents wait in the Unassigned inbox until a
  // user confirms (tags to a company, possibly auto-filed) or dismisses the
  // prompt. Regular uploads carry null (no triage needed).
  assignmentStatus String? // NEEDS_CONFIRMATION | CONFIRMED | DISMISSED
  uploadedAt   DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  processedAt  DateTime?
  deletedAt    DateTime?
  // sha256 of the file bytes — duplicate detection on upload/email intake.
  contentHash String?
  // Folder import: this file is staged inside an IntakeBatch (status STAGED,
  // held out of the Data Room) until a user confirms the destination;
  // intakePath keeps its position inside the imported folder tree.
  intakeBatchId String?
  intakePath     String?
  intakeBatch    IntakeBatch? @relation(fields: [intakeBatchId], references: [id])

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collection Collection?       @relation(fields: [collectionId], references: [id])
  entity     Entity?           @relation(fields: [entityId], references: [id])
  owner      User              @relation(fields: [ownerId], references: [id])
  sections  DocumentSection[]
  tables    DocumentTable[]
  chunks    DocumentChunk[]
  summary   DocumentSummary?
  citations Citation[]
  results   ExtractionResult[]
  evidence AnswerEvidence[]
  covenantDefinitions CovenantDefinition[]

  @@index([workspaceId, status])
  @@index([collectionId])
  @@index([entityId])
  @@index([workspaceId, name])
  @@index([workspaceId, contentHash])
  @@index([intakeBatchId])
}

// A folder import: files staged from one directory pick, held out of the
// Data Room (Document.status STAGED) until a user reviews the preview and
// confirms where the folder tree should land. Cancel discards cleanly.
model IntakeBatch {
  id          String    @id @default(cuid())
  workspaceId String
  name        String    // root folder name ("Acme 2026 statements")
  status      String    @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  rejected    Json?     // files skipped at stage time: [{file, reason}]
  createdById String
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([workspaceId, status])
}

// Structure extracted from a document: headings, paragraphs, footnotes.
model DocumentSection {
  id          String        @id @default(cuid())
  documentId  String
  kind        StructureKind
  level       Int?          // heading level (1..n)
  headingPath Json?         // breadcrumb array, e.g. ["3. Results", "3.2 Segments"]
  page        Int?
  order       Int
  text        String @db.Text

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, order])
  @@index([documentId, kind])
}

// Tables with preserved rows; spreadsheet sheets become tables too.
model DocumentTable {
  id         String  @id @default(cuid())
  documentId String
  sheet      String? // sheet name for spreadsheets
  title      String?
  page       Int?
  order      Int
  header     Json?   // column labels
  pageWidth  Float?  // PDF page geometry (sidecar)
  pageHeight Float?
  bbox       Json?   // {x0, top, x1, bottom} of the table on its page
  contextAbove Json? // ~3 text lines above the table — where "(in thousands)" lives

  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  rows     DocumentTableRow[]

  @@index([documentId, order])
}

model DocumentTableRow {
  id       String @id @default(cuid())
  tableId  String
  rowIndex Int
  cells    Json   // array of cell values, aligned with DocumentTable.header

  table DocumentTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, rowIndex])
}

// Retrieval unit: keeps source pointers (page/heading/table) for citations.
model DocumentChunk {
  id          String  @id @default(cuid())
  documentId  String
  page        Int?
  sheet       String?
  headingPath Json?
  tableId     String?
  kind        CitationKind @default(PARAGRAPH)
  text        String  @db.Text
  embedding   Json?   // float array (re-ranked via cosine when present)
  emb         Unsupported("vector")? // pgvector mirror of embedding, HNSW-indexed — raw SQL only
  tokenEstimate Int
  regions     Json?   // evidence geometry: PDF {page,bbox}[] | DOCX {paragraph} | XLSX {sheet,range} | TXT {startLine,endLine}

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentSummary {
  id         String  @id @default(cuid())
  documentId String  @unique
  summary    String  @db.Text
  keyFacts   Json    // [{label, value, page?}]
  figures    Json    // [{label, value, unit, page?, tableRef?}]
  model      String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ── Conversations & grounded answers ─────────────────────────────────────

model Conversation {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  title        String
  documentIds  Json     @default("[]")
  collectionId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([workspaceId, updatedAt])
  @@index([userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  model          String?
  latencyMs      Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  citations    Citation[]

  @@index([conversationId, createdAt])
}

model Citation {
  id          String       @id @default(cuid())
  messageId   String
  documentId  String
  ref         Int          // visible citation number [n]
  kind        CitationKind
  page        Int?
  sheet       String?
  tableRef    String?      // e.g. "Table 2 · row 4" or "Sheet: Q3 · B7"
  excerpt     String       @db.Text
  chunkId     String?
  createdAt   DateTime     @default(now())

  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([documentId])
}

// ── Data extraction ────────────────────────────────────────────────────

model ExtractionTemplate {
  id          String  @id @default(cuid())
  workspaceId String? // null = built-in template shared by everyone
  name        String
  description String?
  fields      Json    // [{key, label, type, description}]
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  tasks     ExtractionTask[]

  @@index([workspaceId])
}

model ExtractionTask {
  id          String              @id @default(cuid())
  workspaceId String
  name        String
  templateId  String?
  documentIds Json                @default("[]")
  status      ExtractionTaskStatus @default(PENDING)
  error       String?
  createdById String
  createdAt   DateTime            @default(now())
  completedAt DateTime?
  deletedAt   DateTime?

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  ExtractionTemplate? @relation(fields: [templateId], references: [id])
  fields    ExtractionField[]
  results   ExtractionResult[]

  @@index([workspaceId, status])
}

model ExtractionField {
  id        String @id @default(cuid())
  taskId    String
  key       String
  label     String
  type      String @default("text") // text | number | currency | percent | date
  description String?
  order     Int
  isCustom  Boolean @default(false)

  task   ExtractionTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  results ExtractionResult[]

  @@unique([taskId, key])
}

model ExtractionResult {
  id           String       @id @default(cuid())
  taskId       String
  fieldId      String
  documentId   String?
  value        String?
  unit         String?
  confidence   Float        @default(0)
  page         Int?
  sheet        String?
  cell         String?      // e.g. "B7" or "p3 t1 r5 c2"
  bbox         Json?        // PDF cell/row bbox for the evidence viewer
  excerpt      String?      @db.Text
  scale        Json?        // unit-scale provenance: {multiplier, label, from, page, tableId, headerText, flags}
  status       ResultStatus  @default(NEEDS_REVIEW)
  flagged      Boolean      @default(false)
  note         String?
  reviewedById String?
  reviewedAt   DateTime?

  task       ExtractionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field      ExtractionField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  document   Document?     @relation(fields: [documentId], references: [id])

  @@unique([taskId, fieldId, documentId])
  @@index([taskId])
}

// ── Questionnaires ──────────────────────────────────────────────────────

model Questionnaire {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  description String?
  status      String   @default("in_progress") // draft | in_progress | completed
  source      String   @default("custom")      // custom | imported
  documentIds String[] @default([])           // data-room docs the AI may answer from
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([workspaceId, updatedAt])
}

model Question {
  id              String  @id @default(cuid())
  questionnaireId String
  section         String  @default("General")
  order           Int
  type            String  @default("text") // yes_no | multiple_choice | text | table
  prompt          String  @db.Text
  options         Json?   // for multiple choice
  required        Boolean @default(true)

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  answer       QuestionAnswer?

  @@index([questionnaireId, order])
}

model QuestionAnswer {
  id            String        @id @default(cuid())
  questionId    String        @unique
  draftAnswer   String?       @db.Text
  finalAnswer   String?       @db.Text
  confidence    Float?
  status        AnswerStatus  @default(MISSING)
  comment       String?
  reviewedById  String?
  reviewedAt    DateTime?
  updatedAt     DateTime      @updatedAt

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  evidence AnswerEvidence[]

  @@index([status])
}

model AnswerEvidence {
  id         String @id @default(cuid())
  answerId   String
  documentId String?
  page       Int?
  kind       CitationKind @default(PARAGRAPH)
  tableRef   String?
  excerpt    String @db.Text

  answer   QuestionAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  document Document?      @relation(fields: [documentId], references: [id])

  @@index([answerId])
}

// ── Analytics ──────────────────────────────────────────────────────────

model Entity {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  // Group structure: a subsidiary points at its parent borrower. Portfolio
  // rolls up parents; company pages list children.
  parentId    String?
  createdAt   DateTime @default(now())

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      Entity?            @relation("EntityStructure", fields: [parentId], references: [id], onDelete: SetNull)
  subsidiaries Entity[]          @relation("EntityStructure")
  observations MetricObservation[]
  reports     Report[]
  covenantDefinitions CovenantDefinition[]
  packageItems PackageItem[]
  documents   Document[]
  collections Collection[]

  @@unique([workspaceId, name])
  @@index([parentId])
}

// One expected line item in a borrower's quarterly reporting package — e.g.
// "Financial statements". `keywords` is a comma-separated list of
// case-insensitive substrings matched against document names to decide
// whether the item arrived in a given quarter (any document tagged to the
// borrower whose name matches, with an arrival date inside the quarter).
model PackageItem {
  id        String   @id @default(cuid())
  entityId  String
  label     String
  keywords  String
  required  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
}

// One metric for one period. Derivation distinguishes reported vs calculated
// vs AI-inferred; every row can point at its supporting document.
model MetricObservation {
  id                String     @id @default(cuid())
  entityId          String
  metricKey         String     // e.g. revenue | operating_margin | net_debt
  label             String
  period            String     // e.g. "Q3 2026"
  periodStart       DateTime?
  value             Float
  unit              String     @default("USD")
  derivation        Derivation @default(REPORTED)
  confidence        Float?
  sourceDocumentId  String?
  sourcePage        Int?
  sourceExcerpt     String?    @db.Text
  scale             Json?      // unit-scale provenance carried over from the reviewed extraction result
  inputs            Json?      // CALCULATED lineage: [{key, metricKey, kind, periods, observationIds, value}]
  extractionResultId String?
  createdAt         DateTime   @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, metricKey, period])
  @@index([entityId, metricKey])
}

// One row per real overwrite of a stored metric figure. Upsert guards elsewhere
// keep conflicting ingest values out; a revision is recorded whenever an
// existing observation's value actually changes (manual edit or formula
// recompute), so Data Quality can show who changed what, when.
model ObservationRevision {
  id            String   @id @default(cuid())
  workspaceId   String
  observationId String
  entityId      String
  metricKey     String
  period        String
  oldValue      Float
  newValue      Float
  oldDerivation Derivation
  newDerivation Derivation
  source        String   // MANUAL | RECALC
  actorId       String?  // null = system (formula recompute)
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation("RevisionActor", fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([entityId, metricKey, period])
}

model Report {
  id          String   @id @default(cuid())
  workspaceId String
  entityId    String?
  title       String
  type        String   @default("quarterly")
  params      Json     @default("{}")
  schedule    String?  // cron expression; null = on-demand only
  lastRunAt   DateTime?
  content     Json?
  createdById String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entity    Entity?   @relation(fields: [entityId], references: [id])

  @@index([workspaceId])
}

// A saved Explore view: dataset + filters (companies, metrics, window),
// reloadable in one click. The chart itself is re-recommended on load — the
// saved spec is the question, not a frozen picture.
model SavedChartView {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  spec        Json     // { entityIds: string[], metricKeys: string[], quarters: number }
  createdById String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ── Covenants ────────────────────────────────────────────────────────────

enum CovenantComparator {
  LTE // value must stay at or below threshold (maximum covenants)
  GTE // value must stay at or above threshold (minimum covenants)
}

enum CovenantStatus {
  AI_INFERRED
  REVIEWED
}

enum CovenantResultStatus {
  PASS
  FAIL
  NOT_TESTED
  WAIVED
}

// A covenant extracted from a credit agreement (or defined manually), linked
// to the metric it constrains and the clause it came from.
model CovenantDefinition {
  id           String              @id @default(cuid())
  workspaceId  String
  entityId     String
  documentId   String?             // credit agreement the covenant was extracted from
  key          String              // e.g. max_net_leverage
  label        String              // "Maximum net leverage"
  description  String?             @db.Text
  metricKey    String              // MetricObservation.metricKey this covenant tests
  comparator   CovenantComparator
  threshold    Float
  unit         String              @default("x") // x | % | USD | days
  period       String              @default("quarter") // quarter | ttm
  formula      String?             // e.g. "(debt - cash) / ebitda" — null = single-metric covenant, unchanged behavior
  terms        Json?               // formula inputs: {inputs: [{key, metricKey, kind: flow|stock|ratio}], where?}
  schedule     Json?               // step-downs: [{effectiveFrom: "Q1 2026", threshold: 3.5}]
  cure         Json?               // recorded cure events (display only — never auto-applied)
  nearBreachPct Float?             // e.g. 15 = alert when headroom ≤ 15% of threshold
  sourceExcerpt String?            @db.Text
  sourcePage   Int?
  confidence   Float               @default(0)
  status       CovenantStatus      @default(AI_INFERRED)
  reviewedById String?
  reviewedAt   DateTime?
  createdById String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entity    Entity            @relation(fields: [entityId], references: [id], onDelete: Cascade)
  document  Document?         @relation(fields: [documentId], references: [id])
  results   CovenantResult[]

  @@unique([entityId, key])
  @@index([workspaceId])
}

// One covenant tested against one period's observed metric value.
model CovenantResult {
  id           String               @id @default(cuid())
  definitionId String
  period       String               // e.g. "Q3 2026"
  value        Float?
  status       CovenantResultStatus
  headroom     Float?               // signed distance to threshold; positive = compliant
  observationId String?             // MetricObservation backing the value
  reason       String?              // why NOT_TESTED (e.g. unresolved scale flags on the observation)
  nearBreach   Json?                // {withinPct, headroomPct, nearBreachPct} when the definition sets a near-breach band
  previousStatus CovenantResultStatus? // status before the latest evaluation — NOT_TESTED can mask the last real one
  computedAt   DateTime             @default(now())

  definition CovenantDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, period])
  @@index([definitionId, period])
}

// ── Notifications, audit, jobs ───────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String?
  kind       String    // document.completed | invitation.received | ...
  title      String
  body       String?
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([userId, readAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String?
  actorId     String?
  action      String   // user.signup, document.upload, document.download, role.change ...
  targetType  String?
  targetId   String?
  meta        Json?
  ip          String?
  createdAt  DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  actor     User?      @relation("AuditActor", fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([action])
}

// Postgres-backed job queue (workers claim rows with SELECT ... FOR UPDATE SKIP LOCKED)
model Job {
  id          String    @id @default(cuid())
  type        String    // PROCESS_DOCUMENT | RUN_EXTRACTION | DRAFT_QUESTIONNAIRE | REFRESH_ANALYTICS
  payload     Json
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

// DB-backed document storage — used when S3/R2 STORAGE_* vars are not set
// (STORAGE_DRIVER=db is the automatic default in that case). Open-source
// Postgres as the object store; S3/R2 remains the drop-in upgrade.
model StoredObject {
  key         String   @id
  contentType String
  data        Bytes
  sizeBytes   Int
  createdAt   DateTime @default(now())
}
