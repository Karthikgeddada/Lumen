# ── Core ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Render Postgres, Supabase, Neon, RDS, ...)
DATABASE_URL=postgresql://user:password@host:5432/lumen

# Secret used to sign access/refresh JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Exact URL of the deployed Vercel frontend (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# Comma-separated list of allowed browser origins for CORS.
# Include the Vercel URL and any preview URLs you use.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Render binds the port via this variable; default fallback for local dev
PORT=4000
NODE_ENV=development

# ── Mail (verification codes, password reset, invitations) ──────────────
# Any SMTP provider (Resend, Postmark, SES, Gmail app password...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Lumen <no-reply@yourdomain.com>"
# Dev only: log codes instead of sending email. NEVER enable in production.
MAIL_DEV_MODE=false

# ── AI provider (OpenAI-compatible) ──────────────────────────────────────
# Works with OpenAI, Azure OpenAI gateways, OpenRouter, Together, etc.
AI_PROVIDER_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: when empty, retrieval falls back to keyword search only.

# ── Object storage for uploaded documents (S3-compatible) ────────────────
# Render's disk is ephemeral — permanent files must live in object storage.
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, Render object... etc.
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=lumen-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Limits & knobs ──────────────────────────────────────────────────────
MAX_UPLOAD_MB=500
